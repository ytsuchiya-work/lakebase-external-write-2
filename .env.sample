# 6 通り（3 方式 x Python/Java）共通の接続設定。.env にコピーして値を埋める（.env はコミットしない）。

# --- SP の OAuth（M2M）資格情報: 全方式で使う ---
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_CLIENT_ID=<service-principal-client-id>
DATABRICKS_CLIENT_SECRET=<service-principal-oauth-secret>

# --- 方式1・2（Postgres プロトコルで直接接続） ---
# databricks postgres list-endpoints projects/<project-id>/branches/<branch-id> で確認
ENDPOINT_NAME=projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>
PGHOST=<endpoint-uid>.database.<region>.cloud.databricks.com
PGDATABASE=databricks_postgres
PGUSER=<service-principal-client-id>
PGPORT=5432
PGSSLMODE=require
PGSCHEMA=write_test

# --- 方式3（Data API） ---
# Lakebase UI の Data API ページに表示される API URL（スキーマ名は含まない）
REST_ENDPOINT=https://<endpoint-uid>.database.<region>.cloud.databricks.com/api/2.0/workspace/<workspace-id>/rest/<database>

# --- 所有者として psql で入るとき（sql/psql_owner.sh） ---
# プロジェクト所有者ユーザーでログイン済みの Databricks CLI プロファイル名
DATABRICKS_PROFILE=<owner-cli-profile>
