# 接続情報とシークレット（.env.sample をコピーして作る）
.env

# 環境固有の設定（settings.xml.sample をコピーして作る）
java/settings.xml

# 解説ドキュメントの生成用ファイルと画面キャプチャ（環境固有の値を含むため公開しない）
docs/
results/*.png

# Python
python/.venv/
python/__pycache__/

# Java / Maven
java/target/

# Compiled class file
*.class

# Log file（results/ の実行ログは残す）
*.log
!results/*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
